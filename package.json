{
  "name": "awayday",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/big-shoulders": "^0.4.1",
    "@expo-google-fonts/big-shoulders-stencil": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/ui": "~57.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "db:seed": "node --experimental-strip-types scripts/generate-fixtures-seed.mjs",
    "test": "vitest run",
    "db:tascos": "node --env-file=.env.local scripts/importar-tascos-osm.mjs",
    "db:centros-comerciais": "node --env-file=.env.local scripts/tascos-centros-comerciais.mjs",
    "db:pesquisa-tascos": "node --env-file=.env.local scripts/importar-pesquisa-tascos.mjs",
    "db:wc": "node --env-file=.env.local scripts/importar-wc-osm.mjs",
    "db:fotos": "node --env-file=.env.local scripts/fotos-estadios.mjs",
    "db:fotos-tascos": "node --env-file=.env.local scripts/fotos-tascos.mjs",
    "db:estacionamento": "node --env-file=.env.local scripts/importar-estacionamento.mjs",
    "db:parques-osm": "node --env-file=.env.local scripts/importar-parques-osm.mjs",
    "db:ruas": "node --env-file=.env.local scripts/importar-ruas-estadios.mjs",
    "db:estadios-europa": "node --env-file=.env.local scripts/importar-estadios-europa.mjs",
    "db:notas-adeptos": "node --env-file=.env.local scripts/geocodificar-notas-adeptos.mjs",
    "db:adeptos-casa": "node scripts/importar-adeptos-casa.mjs",
    "legal:paginas": "node --experimental-strip-types scripts/legal/gerar-paginas.mjs",
    "test:ecras": "jest",
    "test:sql": "sh scripts/testes/sql.sh",
    "test:e2e": "maestro test .maestro",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:ecras",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.ui.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@supabase/.*)"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/vazio.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
