{
  "expo": {
    "name": "AwayDay",
    "slug": "AwayDay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "awayday",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.martimhenriques.awayday",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#187C44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.martimhenriques.awayday",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#187C44",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#19763F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O AwayDay usa o microfone durante 10 segundos para medir o barulho da bancada. Nada é gravado.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O AwayDay usa a câmara para tirares a tua foto de perfil, a do grupo, fotos da viagem e de tascos, e as provas das missões.",
          "photosPermission": false,
          "microphonePermission": "O AwayDay usa o microfone durante 10 segundos para medir o barulho da bancada. Nada é gravado."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O AwayDay usa a tua localização no momento em que fazes check-in num tasco, carimbas o estádio, escolhes o ponto de partida de uma boleia ou procuras a casa de banho mais perto. A tua posição não fica guardada.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "O AwayDay não usa os sensores de movimento. Este texto existe porque a biblioteca de localização inclui essa função; o AwayDay nunca a ativa."
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O AwayDay usa o Face ID para abrir a app quando ligas o bloqueio."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "O AwayDay usa o Face ID para abrir a app quando ligas o bloqueio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#187C44"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1b5fdb5-078f-4853-a26c-bc565cec0160"
      }
    },
    "owner": "martim03330",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a1b5fdb5-078f-4853-a26c-bc565cec0160"
    },
    "backgroundColor": "#187C44"
  }
}
